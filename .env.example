# Copier ce fichier en .env.local puis adapter les valeurs. Ne jamais committer .env.local.

# PostgreSQL local (adapter utilisateur / mot de passe / nom de base)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plateforme_evenementielle

# Mots de passe des comptes créés par `pnpm db:seed` (dev uniquement, valeurs par défaut ci-dessous)
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_AGENT_PASSWORD=Agent123!
